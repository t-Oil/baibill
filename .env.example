# Application
NODE_ENV=develop
APP_NAME=Receipt OCR API
APP_URL=http://localhost:4000
APP_PORT=4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=receipt_ocr
DB_SYNC=false
DB_AUTO_MIGRATE=false
DB_DEBUG=false
DB_DROP_SCHEMA=false
DB_SSL=false

# JWT (for future auth)
JWT_ACCESS_SECRET=your_access_secret_here
JWT_ACCESS_EXPIRE=30m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRE=1h

# GCP Vision API
GCP_PROJECT_ID=your-gcp-project-id
GCP_CREDENTIALS_PATH=/path/to/service-account-key.json
# OR use base64 encoded credentials (for deployment)
# GCP_CREDENTIALS_BASE64=base64_encoded_json_here

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/jpg
UPLOAD_TEMP_DIR=./tmp/uploads

# OpenAI (optional AI-enhanced receipt parsing)
OPENAI_ENABLED=false
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# Docker Compose Environment Variables
# Copy this file to .env and update the values for your environment

# ============================================
# Application Configuration
# ============================================
APP_NAME=Receipt OCR
APP_URL=http://localhost
PER_PAGE=10

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DATABASE_NAME=receipt_ocr_db
DATABASE_USER=receipt_ocr_user
DATABASE_PASSWORD=your_secure_database_password_here_change_me
DATABASE_SYNC=false

# Auto-Migration: TypeORM migrations run automatically on container startup
# (DB_AUTO_MIGRATE=true is configured in docker-compose.yml)
# All database tables will be created automatically from 19 migration files

# ============================================
# JWT Configuration
# ============================================
# Generate secure random secrets:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_change_me_generate_random_64_char_string
JWT_ACCESS_EXPIRE=30m
JWT_REFRESH_SECRET=your_refresh_secret_change_me_generate_random_64_char_string
JWT_REFRESH_EXPIRE=7d

# ============================================
# OCR Provider Configuration
# ============================================
# Choose one: OpenAI or Google Cloud Vision

# OpenAI OCR (GPT-4 Vision)
OPENAI_ENABLED=true
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0

# Google Cloud Vision OCR (Alternative)
# OPENAI_ENABLED=false
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-vision.json
# Note: Mount your GCP credentials file as a volume in docker-compose.yml

# ============================================
# Email Configuration (Optional)
# ============================================
# Required for user invitations and notifications
# Using Mailjet as the email provider
MAILJET_API_KEY=your_mailjet_api_key_here
MAILJET_API_SECRET=your_mailjet_api_secret_here
MAIL_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# Logging Configuration (Optional)
# ============================================
# Logtail.com integration for centralized logging
LOGTAIL_SOURCE_TOKEN=your_logtail_token_here_optional

# ============================================
# Frontend Configuration
# ============================================
# Public API URL (accessible from browser)
# For local: http://localhost/api
# For production: https://yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost/api

# ============================================
# Security Notes
# ============================================
# 1. Change all default passwords and secrets before deploying
# 2. Use strong, randomly generated passwords (minimum 32 characters)
# 3. Never commit the actual .env file to version control
# 4. For production, consider using Docker secrets or a secrets manager
# 5. Set DATABASE_SYNC=false in production (use migrations instead)
# 6. Regularly rotate JWT secrets, API keys, and database passwords
# 7. Keep your OpenAI API key secure - it has billing implications
# 8. Restrict API key permissions to only what's needed

# ============================================
# OCR Provider Setup Guide
# ============================================
# Option 1: OpenAI (Recommended for ease of use)
#   1. Sign up at https://platform.openai.com
#   2. Create an API key
#   3. Set OPENAI_ENABLED=true and add your key to OPENAI_API_KEY
#   4. Recommended model: gpt-4o (better accuracy than gpt-4-turbo)
#
# Option 2: Google Cloud Vision
#   1. Create a GCP project at https://console.cloud.google.com
#   2. Enable Vision API
#   3. Create a service account and download JSON credentials
#   4. Mount the JSON file in docker-compose.yml volumes
#   5. Set OPENAI_ENABLED=false
#   6. Set GOOGLE_APPLICATION_CREDENTIALS path

# ============================================
# Production Deployment Checklist
# ============================================
# [ ] Change DATABASE_PASSWORD to a strong password
# [ ] Generate new JWT_ACCESS_SECRET (64+ characters)
# [ ] Generate new JWT_REFRESH_SECRET (64+ characters)
# [ ] Set DATABASE_SYNC=false
# [ ] Add your OCR provider credentials (OpenAI or GCP)
# [ ] Configure email provider (Mailjet or alternative)
# [ ] Configure SSL certificates in nginx/ssl/
# [ ] Enable HTTPS redirect in nginx/conf.d/default.conf
# [ ] Update NEXT_PUBLIC_API_URL to your production domain
# [ ] Update APP_URL to your production domain
# [ ] Configure firewall rules (close unnecessary ports)
# [ ] Set up automated backups for PostgreSQL
# [ ] Enable monitoring and logging
# [ ] Review and adjust rate limiting in Nginx configuration
# [ ] Test OCR functionality with sample receipts
# [ ] Test email delivery for invitations

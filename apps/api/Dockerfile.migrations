# Migrations Dockerfile
# Includes source files and dev dependencies needed for TypeORM CLI

FROM node:22-alpine

# Install security updates and necessary tools
RUN apk upgrade --no-cache && \
    apk add --no-cache python3 make g++ && \
    rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /app

# Copy root package files (for workspace)
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/

# Install ALL dependencies (including dev) for migrations
RUN npm ci --workspace=apps/api

# Copy source files needed for migrations
COPY apps/api/src ./apps/api/src
COPY apps/api/tsconfig*.json ./apps/api/
COPY tsconfig.base.json ./

# Set working directory to API
WORKDIR /app/apps/api

# Run migrations using standalone script (doesn't bootstrap full NestJS app)
CMD ["npm", "run", "migration:run:standalone"]
